{
  "name": "ascii-earth",
  "version": "0.1.1",
  "description": "A rotating 3D Earth drawn with ASCII characters on a canvas, lit by the real position of the sun.",
  "license": "MIT",
  "keywords": [
    "ascii",
    "ascii-art",
    "earth",
    "globe",
    "canvas",
    "3d",
    "sun",
    "animation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcelRochera00/ascii-earth-web.git"
  },
  "homepage": "https://marcelrochera00.github.io/ascii-earth-web/",
  "type": "module",
  "main": "./dist-lib/ascii-earth.js",
  "module": "./dist-lib/ascii-earth.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/ascii-earth.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib && npm test -- --run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
